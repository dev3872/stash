# MongoDB connection string (local, Docker, or Atlas). The database name is part of the URI.
MONGODB_URI=mongodb+srv://dev3872:dev3872@cluster0.ntkybmz.mongodb.net/?appName=Cluster0

# Auth0 tenant domain, without https:// (Auth0 dashboard → Applications → your SPA → Domain)
AUTH0_DOMAIN=dev-c3gbqidu3vv1cbot.us.auth0.com
# Identifier of the Auth0 API you created (Auth0 dashboard → Applications → APIs)
AUTH0_AUDIENCE=https://stash-api

# Origin of the React app. Only this origin may call the API from a browser (comma-separate several).
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# Optional. Without it, posts are made by the built-in local converter.
OPENAI_API_KEY=
# Optional. Model used when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini

# Optional. An email or URL Wikimedia can use to reach you; sent in the User-Agent
# when Stash looks up Wikipedia articles and Commons pictures.
WIKIMEDIA_CONTACT=
