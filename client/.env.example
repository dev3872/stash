# Auth0 tenant domain, without https://
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# Client ID of your Auth0 Single Page Application
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Must equal the server's AUTH0_AUDIENCE (your Auth0 API identifier)
VITE_AUTH0_AUDIENCE=https://stash-api
# Where the Express API runs
VITE_API_URL=http://localhost:4000
